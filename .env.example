PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ENV=sandbox
GEMINI_API_KEY=
GEMINI_API_SECRET=
# Required for master keys: the actual account short name from /v1/account/list.
GEMINI_ACCOUNT=
GEMINI_NONCE_MODE=time
# paper uses live public quotes; sandbox places orders with test funds and sandbox quotes.
TRADING_MODE=paper
DATABASE_URL=sqlite:///./spare_change.db
GEMINI_MARKET_URL=https://api.gemini.com
# Documented taker estimate: ceil(0.07 * contracts * price * (1-price) * 100) cents.
GEMINI_TAKER_RATE=0.07

# Optional market reading links. Searches use public market questions only.
CONTEXT_DEV_API_KEY=

# Optional Claude research swarm; calls run only when you tap Run the research swarm.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# Custodial custom SPC test wallets; mainnet is disabled. Keep this key stable.
XRPL_NETWORK=testnet
XRPL_WALLET_KEY=
APP_ENV=development
# Production requires a stable session secret and a private friend access code.
APP_SESSION_SECRET=
DEMO_ACCESS_CODE=
